package(
    default_visibility = [
        "//visibility:public",
    ],
)

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

ddk_headers(
    name = "audio_common_headers",
    hdrs = glob([
        "include/asoc/*.h",
        "include/bindings/*.h",
        "include/dsp/*.h",
        "include/ipc/*.h",
        "include/soc/*.h"
    ]),
    includes = ["include", "include/uapi"]
)
ddk_headers(
    name = "audio_uapi_headers",
    hdrs = glob([
        "include/uapi/audio/**/*.h",
	"include/uapi/**/*.h",
	"include/uapi/**/**/**/*.h",
	"include/**/**/**/**/*.h"
    ]),
    includes = ["include", "include/uapi", "include/uapi/audio"]
)
ddk_headers(
    name = "audio_src_headers",
    hdrs = glob([
        "asoc/**/*.h",
	"asoc/*.h",
        "dsp/**/*.h",
        "ipc/**/*.h",
        "soc/**/*.h"
    ])
)
ddk_headers(
    name = "audio_configs",
    hdrs = glob([
        "config/*.h"
    ]),
    includes = ["config"]
)
ddk_headers(
    name = "audio_headers",
    hdrs = [":audio_common_headers",  ":audio_uapi_headers", ":audio_src_headers", ":audio_configs"]
)

load(":build/mdm9607.bzl", "define_mdm9607")

define_mdm9607()


