config QTI_DISPLAY_SM6150
	bool "Qualcomm SDE/DSI display driver (techpack/display) for sm6150"
	depends on DRM && ARCH_QCOM && !DRM_MSM
	select DRM_KMS_HELPER
	select DRM_MIPI_DSI
	select SYNC_FILE
	select QCOM_PANEL_EVENT_NOTIFIER
	help
	  Build the Qualcomm display-drivers techpack (msm_drm: SDE, DSI,
	  MDSS PLLs, RSC, writeback) into the kernel with the sm6150 feature
	  set from config/sm6150disp.conf. The driver keeps the msm_drm module
	  name, so the msm_drm.dsi_display0= panel selection from the
	  bootloader still applies.
