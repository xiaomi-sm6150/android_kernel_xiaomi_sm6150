			/* NEW-ON-6.1 (dt/61/sm6150-dma-heaps.dtsi): reference SoC values, check for the target */
			qcom,sp_hlos {
				qcom,dma-heap-name = "qcom,sp-hlos";
				qcom,dma-heap-type = <HEAP_TYPE_CMA>;
