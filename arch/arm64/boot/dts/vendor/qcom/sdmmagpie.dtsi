		tsens0: tsens@c222000 {
			compatible = "qcom,tsens24xx";
			reg = <0xc222000 0x8>, <0xc263000 0x1ff>;
			reg-names = "tsens_srot_physical",
			    "tsens_tm_physical";
			interrupts = <GIC_SPI 506 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 508 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "tsens-upper-lower", "tsens-critical";
			tsens-reinit-wa;
			#thermal-sensor-cells = <1>;
		};

		/* NEW-ON-6.1 (dt/61/sm6150-thermal.dtsi): reference SoC values, check for the target */
		qcom,cpu-pause {
			compatible = "qcom,thermal-pause";

			/* NEW-ON-6.1 (dt/61/sm6150-thermal.dtsi): reference SoC values, check for the target */
			cpu0_pause: cpu0-pause {
				qcom,cpus = <&CPU0>;
				qcom,cdev-alias = "thermal-pause-1";
				#cooling-cells = <2>;
			};

