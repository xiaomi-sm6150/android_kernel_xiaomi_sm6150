			qcom,iommu-dma = "bypass";
			iommus = <&apps_smmu 0x0240 0x1>;
			interrupts = <GIC_SPI 414 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 415 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 416 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 418 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 419 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 420 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 421 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 423 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 424 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 425 IRQ_TYPE_LEVEL_HIGH>;
			vdd-0.8-cx-mx-supply = <&pm6150_l9>;
			vdd-1.8-xo-supply = <&pm6150l_l1>;
			vdd-1.3-rfa-supply = <&pm6150l_l2>;
			vdd-3.3-ch0-supply = <&pm6150l_l10>;
			vdd-3.3-ch1-supply = <&pm6150l_l11>;

			/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
			wifi-firmware {
				iommus = <&apps_smmu 0x1642 0x1>;
			};
		};

		bluetooth: bt_wcn3990 {
			compatible = "qcom,wcn3990";
			qcom,bt-vdd-io-supply = <&pm6150_l10>;
			qcom,bt-vdd-core-supply = <&pm6150l_l2>;
			qcom,bt-vdd-pa-supply = <&pm6150l_l10>;
			qcom,bt-vdd-io-config = <1800000 1900000 1 0>;
			qcom,bt-vdd-core-config = <1304000 1304000 1 0>;
			qcom,bt-vdd-pa-config = <3312000 3312000 1 0>;
			qcom,bt-vdd-xtal-supply = <&pm6150l_l1>;
			qcom,bt-vdd-xtal-config = <1800000 1900000 1 0>;
		};

		/* MERGE interrupts-extended: 4.14 target has <&pdc GIC_SPI 266 IRQ_TYPE_EDGE_RISING>, <&modem_smp2p_in 0 IRQ_TYPE_NONE>, <&modem_smp2p_in 1 IRQ_TYPE_NONE>, <&modem_smp2p_in 2 IRQ_TYPE_NONE>, <&modem_smp2p_in 3 IRQ_TYPE_NONE>, <&modem_smp2p_in 7 IRQ_TYPE_NONE> */
		/* MERGE interrupt-names: 4.14 target has "qcom,wdog",
				  "qcom,err-fatal",
				  "qcom,err-ready",
				  "qcom,proxy-unvote",
				  "qcom,stop-ack",
				  "qcom,shutdown-ack" */
		mpss_pas: pil_modem: remoteproc-mpss@4080000 {
			compatible = "qcom,sm8150-mpss-pas";
			reg = <0x4080000 0x100>;
			cx-supply = <&VDD_CX_LEVEL>;
			cx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 100000>;
			mss-supply = <&VDD_MSS_LEVEL>;
			mss-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 100000>;
			reg-names = "cx", "mss";
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";
			qcom,qmp = <&aoss_qmp>;
			qcom,signal-aop;
			memory-region = <&pil_modem_mem>;
			interrupts-extended = <&intc GIC_SPI 266 IRQ_TYPE_EDGE_RISING>, <&modem_smp2p_in 0 0>, <&modem_smp2p_in 2 0>, <&modem_smp2p_in 1 0>, <&modem_smp2p_in 3 0>, <&modem_smp2p_in 7 0>;
			interrupt-names = "wdog",
				"fatal",
				"handover",
				"ready",
				"stop-ack",
				"shutdown-ack";
			qcom,smem-states = <&modem_smp2p_out 0>;
			qcom,smem-state-names = "stop";
			k61,late-boot;
			k61,no-panic;
			k61,wait-qmi-service = <14>;

			/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
			glink-edge {
				qcom,remote-pid = <1>;
				transport = "smem";
				mboxes = <&apss_shared 12>;
				mbox-names = "mpss_smem";
				interrupts = <GIC_SPI 449 IRQ_TYPE_EDGE_RISING>;
				label = "modem";
				qcom,glink-label = "mpss";

				/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
				qcom,modem_qrtr {
					qcom,glink-channels = "IPCRTR";
					qcom,intents = <0x800 5 0x2000 3 0x4400 2>;
				};

				/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
				qcom,modem_ds {
					qcom,glink-channels = "DS";
					qcom,intents = <0x4000 0x2>;
				};

				/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
				qcom,modem_glink_ssr {
					qcom,glink-channels = "glink_ssr";
				};
			};
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		ipa: ipa@1e40000 {
			compatible = "qcom,sc7180-ipa";
			iommus = <&apps_smmu 0x520 0x0>, <&apps_smmu 0x522 0x0>;
			reg = <0x1e40000 0x7000>, <0x1e47000 0x2000>, <0x1e04000 0x2c000>;
			reg-names = "ipa-reg", "ipa-shared", "gsi";
			interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING>, <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>, <&smp2p_ipa_1_in 0 IRQ_TYPE_EDGE_RISING>, <&smp2p_ipa_1_in 1 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "ipa", "gsi", "ipa-clock-query",
				  "ipa-setup-ready";
			clocks = <&rpmhcc RPMH_IPA_CLK>;
			clock-names = "core";
			interconnects = <&aggre2_noc MASTER_IPA &mc_virt SLAVE_EBI1>, <&aggre2_noc MASTER_IPA &system_noc SLAVE_IMEM>, <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_IPA_CFG>;
			interconnect-names = "memory", "imem", "config";
			memory-region = <&pil_ipa_fw_mem>;
			qcom,qmp = <&aoss_qmp>;
			qcom,smem-states = <&smp2p_ipa_1_out 0>, <&smp2p_ipa_1_out 1>;
			qcom,smem-state-names = "ipa-clock-enabled-valid",
					"ipa-clock-enabled";
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		gpio-keys {
			compatible = "gpio-keys";
			label = "gpio-keys";
			pinctrl-names = "default";
			pinctrl-0 = <&key_vol_up_default>;

			/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
			key-vol-up {
				label = "volume_up";
				gpios = <&pm6150l_gpios 2 GPIO_ACTIVE_LOW>;
				linux,code = <KEY_VOLUMEUP>;
				debounce-interval = <15>;
				wakeup-source;
			};
		};

		/* FROM-4.14 (dt/414/sdmmagpie.dtsi): target only, 4.14 bindings, check */
		tsens1: tsens@c223000 {
			compatible = "qcom,tsens24xx";
			reg = <0xc223000 0x8>, <0xc265000 0x1ff>;
			reg-names = "tsens_srot_physical",
			    "tsens_tm_physical";
			interrupts = <GIC_SPI 507 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 509 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "tsens-upper-lower", "tsens-critical";
			tsens-reinit-wa;
			#thermal-sensor-cells = <1>;
		};

		/* FROM-4.14 (dt/414/sdmmagpie-gdsc.dtsi): target only, 4.14 bindings, check */
		gpu_gx_domain_addr: syscon@0x5091508 {
