			reg = <0x5091508 0x4>;
		};

		/* FROM-4.14 (dt/414/sdmmagpie-gdsc.dtsi): target only, 4.14 bindings, check */
		gpu_gx_sw_reset: syscon@0x5091008 {
			compatible = "syscon";
			reg = <0x5091008 0x4>;
		};

		/* FROM-4.14 (dt/414/sdmmagpie-gdsc.dtsi): target only, 4.14 bindings, check */
		mvsc_gdsc: qcom,gdsc@0b00814 {
