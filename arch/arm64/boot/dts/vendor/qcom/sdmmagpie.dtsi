		/* MERGE interrupt-names: 4.14 target has "qcom,wdog",
				  "qcom,err-fatal",
				  "qcom,err-ready",
				  "qcom,proxy-unvote",
				  "qcom,stop-ack" */
		adsp_pas: remoteproc-adsp@62400000 {
			compatible = "qcom,sm6150-adsp-pas";
			reg = <0x62400000 0x00100>;
			status = "okay";
			cx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 0>;
			reg-names = "cx", "mx";
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";
			mboxes = <&qmp_aop 0>;
			interconnects = <&aggre2_noc MASTER_CRYPTO &mc_virt SLAVE_EBI1>;
			interconnect-names = "crypto_ddr";
			memory-region = <&rproc_adsp_mem>;
			interrupts-extended = <&intc GIC_SPI 162 IRQ_TYPE_EDGE_RISING>, <&adsp_smp2p_in 0 0>, <&adsp_smp2p_in 2 0>, <&adsp_smp2p_in 1 0>, <&adsp_smp2p_in 3 0>, <&adsp_smp2p_in 7 0>;
			interrupt-names = "wdog",
				"fatal",
				"handover",
				"ready",
				"stop-ack",
				"shutdown-ack";
			qcom,smem-states = <&adsp_smp2p_out 0>;
			qcom,smem-state-names = "stop";
			k61,late-boot;
			k61,no-panic;
			cx-supply = <&L8A_LEVEL>;
			qcom,qmp = <&aoss_qmp>;
			qcom,signal-aop;
			mx-supply = <&L7A_LEVEL>;
			mx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 0>;

			/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
			glink_edge: glink-edge {
				qcom,remote-pid = <2>;
				transport = "smem";
				mboxes = <&apss_shared 24>;
				mbox-names = "adsp_smem";
				interrupts = <GIC_SPI 170 IRQ_TYPE_EDGE_RISING>;
				label = "adsp";
				qcom,glink-label = "lpass";
				cpu-affinity = <1 2>;

				/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
				qcom,adsp_qrtr {
					qcom,glink-channels = "IPCRTR";
