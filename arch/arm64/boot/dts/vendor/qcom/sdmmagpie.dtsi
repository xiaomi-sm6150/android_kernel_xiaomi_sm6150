			/* converted from 4.14 sdmmagpie-qupv3.dtsi (+ board), 6.1 sm6150-qupv3.dtsi form */
			qupv3_se3_4uart: qcom,qup_uart@88c000 {
				compatible = "qcom,msm-geni-serial-hs";
				reg = <0x88c000 0x4000>;
