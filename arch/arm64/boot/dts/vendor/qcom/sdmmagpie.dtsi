	firmware: firmware {

		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <&tcsr 0x13000>;
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo";
			};
		};
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		hyp_region: hyp_region@85700000 {
			no-map;
			reg = <0 0x85700000 0 0x600000>;
		};

		xbl_aop_mem: xbl_aop_mem@85e00000 {
			no-map;
			reg = <0x0 0x85e00000 0x0 0x1ff000>;
		};

		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		aop_cmd_db: memory@85f20000 {
			compatible = "qcom,cmd-db";
			reg = <0x0 0x85f20000 0x0 0x20000>;
			no-map;
		};

		sec_apps_mem: sec_apps_region@85fff000 {
			no-map;
			reg = <0x0 0x85fff000 0x0 0x1000>;
		};

		smem_region: smem@86000000 {
			no-map;
			reg = <0x0 0x86000000 0x0 0x200000>;
		};

		removed_region: removed_region@86200000 {
			no-map;
			reg = <0 0x86200000 0 0x2d00000>;
		};

		pil_camera_mem: camera_region@8ab00000 {
			no-map;
			reg = <0 0x8ab00000 0 0x500000>;
		};

		pil_modem_mem: modem_region@8b000000 {
			no-map;
			reg = <0 0x8b000000 0 0x8400000>;
		};

		pil_video_mem: pil_video_region@93400000 {
			no-map;
			reg = <0 0x93400000 0 0x500000>;
		};

		wlan_msa_mem: wlan_msa_region@97500000 {
			no-map;
			reg = <0 0x97500000 0 0x180000>;
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		rproc_cdsp_mem: rproc_cdsp_region {
			no-map;
			reg = <0x0 0x93900000 0x0 0x1e00000>;
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		rproc_adsp_mem: rproc_adsp_region {
			no-map;
			reg = <0x0 0x95300000 0x0 0x1e00000>;
		};

		pil_ipa_fw_mem: ips_fw_region@97700000 {
			no-map;
			reg = <0 0x97700000 0 0x10000>;
		};

		pil_ipa_gsi_mem: ipa_gsi_region@97710000 {
			no-map;
			reg = <0 0x97710000 0 0x5000>;
		};

		pil_gpu_mem: gpu_region@97715000 {
			no-map;
			reg = <0 0x97715000 0 0x2000>;
		};

		qseecom_mem: qseecom_region {
			compatible = "shared-dma-pool";
			no-map;
			reg = <0 0x9e400000 0 0x1400000>;
		};

		cdsp_sec_mem: cdsp_sec_regions@9f800000 {
			no-map;
			reg = <0x0 0x9f800000 0x0 0x1e00000>;
		};

		adsp_mem: adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x00000000 0 0xffffffff>;
			reusable;
			alignment = <0 0x400000>;
			size = <0 0xc00000>;
		};

		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		user_contig_mem: user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x1000000>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x00000000 0 0xffffffff>;
			reusable;
			alignment = <0 0x400000>;
			size = <0 0x1000000>;
		};

		sp_mem: sp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x00000000 0 0xffffffff>;
			reusable;
			alignment = <0 0x400000>;
			size = <0 0x800000>;
		};

		secure_display_memory: secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x00000000 0 0xffffffff>;
			reusable;
			alignment = <0 0x400000>;
			size = <0 0x5c00000>;
		};

		cont_splash_memory: splash_region {
			reg = <0x0 0x9c000000 0x0 0x01700000>;
			label = "cont_splash_region";
		};

		dfps_data_memory: dfps_data_region@9d700000 {
			reg = <0x0 0x9d700000 0x0 0x0100000>;
			label = "dfps_data_region";
		};

		system_cma: linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x00000000 0 0xffffffff>;
			reusable;
			alignment = <0 0x400000>;
			size = <0 0x2000000>;
			linux,cma-default;
		};

		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		kinfo_mem: debug_kinfo_region {
			alloc-ranges = <0x0 0x00000000 0xffffffff 0xffffffff>;
			size = <0x0 0x1000>;
			no-map;
		};

		/* FROM-4.14 (dt/414/sdmmagpie.dtsi): target only, 4.14 bindings, check */
		npu_mem: npu_region@97680000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0 0x97680000 0 0x80000>;
		};

		/* FROM-4.14 (dt/414/sdmmagpie.dtsi): target only, 4.14 bindings, check */
		cdsp_mem: cdsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x400000>;
		};

		/* FIXUP: written for the target */
		ramoops: ramoops@a1600000 {
			compatible = "ramoops";
			reg = <0x0 0xa1600000 0x0 0x800000>;
			console-size = <0x400000>;
			pmsg-size = <0x400000>;
		};
	};

	/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
	clocks {

		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		xo_board: xo_board {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			clock-output-names = "xo_board";
			#clock-cells = <0>;
		};

		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		sleep_clk: sleep_clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			clock-output-names = "sleep_clk";
			#clock-cells = <0>;
		};
	};

	/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
	qcom,smp2p-modem {
		compatible = "qcom,smp2p";
		qcom,smem = <435>, <428>;
		interrupts = <GIC_SPI 451 IRQ_TYPE_EDGE_RISING>;
		qcom,ipc = <&apcs 0 14>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <1>;

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		modem_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		modem_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		smp2p_ipa_1_out: qcom,smp2p-ipa-1-out {
			qcom,entry-name = "ipa";
			#qcom,smem-state-cells = <1>;
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		smp2p_ipa_1_in: qcom,smp2p-ipa-1-in {
			qcom,entry-name = "ipa";
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		/* NEW-ON-6.1 (dt/61/violet-sm6150.dts): reference SoC values, check for the target */
		smp2p_wlan_1_in: qcom,smp2p-wlan-1-in {
			qcom,entry-name = "wlan";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};
