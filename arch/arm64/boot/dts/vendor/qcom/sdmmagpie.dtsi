		/* NEW-ON-6.1 (dt/61/sm6150.dtsi): reference SoC values, check for the target */
		SILVER_OFF: silver-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <549>;
			exit-latency-us = <901>;
			min-residency-us = <1774>;
			arm,psci-suspend-param = <0x40000003>;
