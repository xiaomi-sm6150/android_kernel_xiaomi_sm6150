	wl2866d@28 {
		compatible = "xiaomi,wl2866d";
		reg = <0x28>;
		vin1-supply = <&S8C>;
		vin1-voltage-level = <1350000  1350000>;
		vin2-supply = <&BOB>;
		vin2-voltage-level = <3300000  3300000>;
		en-gpio = <&tlmm 30 0>;
		status = "ok";
	};
};

&qupv3_se8_spi {
	status = "ok";

	irled@0 {
		compatible = "ir-spi-led";
		reg = <0x0>;
		power-supply = <&irda_regulator>;
		status = "ok";
		spi-max-frequency = <19200000>;
	};
};

&removed_region {
	reg = <0 0x86200000 0 0x4900000>;
};

#include "sdmmagpie-sde.dtsi"
#include "sdmmagpie-gpu.dtsi"
#include "sweet-display.dtsi"

/ {
	k61,dtbo-target = <&soc>;

	__symbols__ {
		soc = "/soc";
	};
};

