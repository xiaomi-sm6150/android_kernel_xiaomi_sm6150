&ufshc_mem {
	vccq2-voltage-level = <1800000 1950000>;
	rpm-level = <3>;
};

&qcom_smcinvoke {
	reg = <0x86d00000 0x3E00000>;
};

&tlmm {

	nfc {
	};

	pmx_ts_active {

		tp_active: tp_active {

			mux {
				pins = "gpio9", "gpio8";
				function = "gpio";
			};

			config {
				pins = "gpio9", "gpio8";
				drive-strength = <16>;
				bias-pull-up;
			};
		};
	};

	pmx_ts_int_suspend {

		tp_int_suspend: tp_int_suspend {

			mux {
				pins = "gpio9";
				function = "gpio";
			};

			config {
				pins = "gpio9";
				drive-strength = <16>;
				input-enable;
				slew-rate = <0>;
				bias-pull-up = <00>;
			};
		};
	};

	pmx_ts_reset_suspend {

		tp_reset_suspend: tp_reset_suspend {

			mux {
				pins = "gpio8";
				function = "gpio";
			};

			config {
				pins = "gpio8";
				drive-strength = <16>;
				slew-rate = <1>;
				bias-disable;
				output-high;
			};
		};
	};

