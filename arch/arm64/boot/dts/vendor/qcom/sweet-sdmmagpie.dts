&pm6150_charger {
	/* MERGE io-channels: 4.14 target has <&pm6150_vadc ADC5_USB_IN_V_16>, <&pm6150_vadc ADC5_USB_IN_I>, <&pm6150_vadc ADC5_CHG_TEMP>, <&pm6150_vadc ADC5_DIE_TEMP>, <&pm6150l_vadc ADC5_AMUX_THM1_100K_PU>, <&pm6150_vadc ADC_SBUx>, <&pm6150_vadc ADC5_VPH_PWR> */
	/* MERGE io-channel-names: 4.14 target has "usb_in_voltage",
			   "usb_in_current",
			   "chg_temp",
			   "die_temp",
			   "conn_temp",
			   "sbux_res",
			   "vph_voltage" */
	io-channels = <&pm6150_vadc ADC5_USB_IN_V_16>, <&pm6150_vadc ADC5_USB_IN_I>, <&pm6150_vadc ADC5_CHG_TEMP>, <&pm6150_vadc ADC5_DIE_TEMP>, <&pm6150l_vadc ADC5_AMUX_THM1_100K_PU>, <&pm6150_vadc ADC5_SBUx>, <&pm6150_vadc ADC5_VPH_PWR>, <&pm6150_qg PSY_IIO_RESISTANCE_ID>, <&pm6150_qg PSY_IIO_VOLTAGE_NOW>, <&pm6150_qg PSY_IIO_TEMP>, <&pm6150_qg PSY_IIO_CAPACITY>, <&pm6150_qg PSY_IIO_VOLTAGE_OCV>, <&pm6150_qg PSY_IIO_VOLTAGE_AVG>, <&pm6150_qg PSY_IIO_DEBUG_BATTERY>, <&pm6150_qg PSY_IIO_REAL_CAPACITY>, <&pm6150_qg PSY_IIO_CC_SOC>, <&pm6150_qg PSY_IIO_CURRENT_NOW>, <&pm6150_qg PSY_IIO_VOLTAGE_MAX>, <&pm6150_qg PSY_IIO_CHARGE_FULL>, <&pm6150_qg PSY_IIO_CHARGE_COUNTER>, <&pm6150_qg PSY_IIO_CYCLE_COUNT>, <&pm6150_qg PSY_IIO_CHARGE_FULL_DESIGN>, <&pm6150_qg PSY_IIO_TIME_TO_FULL_NOW>;
	io-channel-names = "usb_in_voltage", "usb_in_current", "chg_temp", "die_temp", "conn_temp", "sbux_res", "vph_voltage", "resistance_id", "voltage_now", "temp", "capacity", "voltage_ocv", "voltage_avg", "debug_battery", "real_capacity", "cc_soc", "current_now", "voltage_max", "charge_full", "charge_counter", "cycle_count", "charge_full_design", "time_to_full_now";
	qcom,battery-data = <&mtp_batterydata>;
	dpdm-supply = <&qusb_phy0>;
	qcom,sec-charger-config = <0>;
	qcom,chg-term-src = <1>;
	qcom,chg-term-current-ma = <(-200)>;
	qcom,auto-recharge-soc = <99>;
	qcom,sw-jeita-enable;
	qcom,thermal-mitigation = <6000000 5000000 4500000 4000000 3500000 3000000 2900000 2800000 2600000 2400000 2200000 2000000 1800000 1500000 1000000 500000>;
	qcom,thermal-mitigation-icl = <3000000 3000000 3000000 2400000 2200000 2100000 2000000 2000000 2000000 1900000 1800000 1600000 1500000 1300000 1300000 750000>;
	qcom,thermal-mitigation-dcp = <1800000 1800000 1800000 1800000 1800000 1800000 1800000 1800000 1800000 1700000 1600000 1400000 1200000 1100000 1100000 1000000>;
	qcom,thermal-mitigation-qc2 = <1500000 1500000 1500000 1500000 1450000 1400000 1350000 1300000 1150000 1100000 1000000 900000 850000 750000 650000 500000>;
	qcom,thermal-fcc-qc3-normal = <6000000 5000000 4500000 4000000 3500000 3000000 2900000 2800000 2700000 2600000 2400000 2200000 2000000 2000000 750000 700000>;
	qcom,thermal-mitigation-pd-base = <6000000 5000000 4500000 4000000 3400000 3300000 3200000 3100000 3000000 2800000 2600000 2400000 2200000 2000000 1000000 700000>;
	qcom,usb-icl-ua = <3000000>;
	qcom,fcc-max-ua = <6000000>;
	mi,fcc-batt-unverify-ua = <2000000>;
	qcom,fv-max-uv = <4470000>;
	qcom,reg-dump-enable;
	qcom,distinguish-qc-class-ab;
	qcom,lpd-disable;
	qcom,usbpd-phandle = <&pm6150_pdphy>;
	qcom,disable-suspend-on-collapse;
	mi,use-bq-pump;
	mi,support-ffc;
	mi,early-status-report;
	mi,support-qc3p5-without-smb;
	mi,ffc-low-tbat = <150>;
	mi,ffc-high-tbat = <480>;
	qcom,thermal-fcc-qc3-cp = <6000000 5000000 4500000 4000000 3500000 3300000 3200000 3100000 3000000 2800000 2600000 2400000 2200000 2000000 2000000 200000>;
	qcom,thermal-fcc-pps-cp = <6000000 5500000 5000000 4500000 4100000 3900000 3500000 3200000 3100000 2800000 2600000 2400000 2200000 2000000 1000000 700000>;
};

&pm6150_pdphy {
	mi,non-qcom-pps-ctrl;
	mi,pd_curr_limit = <1>;
	mi,pd_max_curr_limit = <4000000>;
	mi,limit_pd_unverified_pps_vbus = <1>;
	mi,pd_unverified_pps_max_vbus_limit = <9500000>;
};

&pm6150_qg {
	qcom,vbatt-low-mv = <3500>;
	qcom,vbatt-low-cold-mv = <3800>;
	qcom,vbatt-empty-cold-mv = <3000>;
	qcom,battery-data = <&mtp_batterydata>;
	qcom,qg-iterm-ma = <350>;
	qcom,s3-entry-ibat-ua = <25000>;
	qcom,s3-exit-ibat-ua = <45000>;
	qcom,hold-soc-while-full;
	qcom,linearize-soc;
	qcom,cl-feedback-on;
	qcom,shutdown-soc-threshold = <10>;
	qcom,qg-ext-sns;
	mi,software-optimize-ffc-qg-iterm;
	qcom,shutdown-delay-enable;
	qcom,tcss-enable;
	qcom,tcss-entry-soc = <90>;
	qcom,bass-enable;
	qcom,soc_decimal_rate = < 0 32 10 30 20 28 30 28 40 28 50 28 60 28 70 28 80 28 90 26 95 10 99 5>;
};

