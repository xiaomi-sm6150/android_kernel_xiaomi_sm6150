	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie-pinctrl.dtsi): target only, 4.14 bindings, check */
	pwm_out_gpio10 {

		/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie-pinctrl.dtsi): target only, 4.14 bindings, check */
		pwm_out_gpio10_default: pwm_out_gpio10_default {
			pins = "gpio10";
			function = "func1";
			bias-disable;
			power-source = <1>;
			output-low;
			qcom,drive-strength = <3>;
			drive-push-pull;
		};
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie.dtsi): target only, 4.14 bindings, check */
	nvm_therm {

		/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie.dtsi): target only, 4.14 bindings, check */
		nvm_therm_default: nvm_therm_default {
			pins = "gpio10";
			bias-high-impedance;
		};
	};
};

&thermal_zones {

	/* board thermistor zone, 4.14 name and trips */
	xo_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm6150_adc_tm 0>;

		trips {

			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	/* board thermistor zone, 4.14 name and trips */
	pa_therm1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm6150_adc_tm 1>;

		trips {

			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	/* board thermistor zone, 4.14 name and trips */
	emmc_ufs_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm6150_adc_tm 2>;

		trips {

			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	/* board thermistor zone, 4.14 name and trips */
	quiet_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm6150_adc_tm 3>;

		trips {

			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	/* board thermistor zone, 4.14 name and trips */
	conn_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm6150l_adc_tm 0>;

		trips {

			active-config0 {
