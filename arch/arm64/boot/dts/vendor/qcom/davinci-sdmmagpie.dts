	reg = <0x86d00000 0x3E00000>;
};

&tlmm {

	pmx_ts_active {

		tp_active: tp_active {

			mux {
				pins = "gpio9", "gpio8";
				function = "gpio";
			};

			config {
				pins = "gpio9", "gpio8";
				drive-strength = <16>;
				bias-pull-up;
			};
		};
	};

	pmx_ts_int_suspend {

		tp_int_suspend: tp_int_suspend {

			mux {
				pins = "gpio9";
				function = "gpio";
			};

			config {
				pins = "gpio9";
				drive-strength = <16>;
				input-enable;
				slew-rate = <0>;
				bias-pull-up = <00>;
			};
		};
	};

	pmx_ts_reset_suspend {

		tp_reset_suspend: tp_reset_suspend {

			mux {
				pins = "gpio8";
				function = "gpio";
			};

			config {
				pins = "gpio8";
				drive-strength = <16>;
				slew-rate = <1>;
				bias-disable;
				output-high;
			};
		};
	};

	cam_sensor_active_wide: cam_sensor_active_wide {

		mux {
			pins = "gpio26";
			function = "gpio";
		};

		config {
			pins = "gpio26";
			bias-disable;
			drive-strength = <2>;
		};
	};

	cam_sensor_suspend_wide: cam_sensor_suspend_wide {

		mux {
			pins = "gpio26";
			function = "gpio";
		};

		config {
			pins = "gpio26";
			bias-pull-down;
			drive-strength = <2>;
			output-low;
		};
	};

	cam_sensor_active_tele: cam_sensor_active_tele {

		mux {
			pins = "gpio24";
			function = "gpio";
		};

		config {
			pins = "gpio24";
			bias-disable;
			drive-strength = <2>;
		};
	};

	cam_sensor_suspend_tele: cam_sensor_suspend_tele {

		mux {
			pins = "gpio24";
			function = "gpio";
		};

		config {
			pins = "gpio24";
			bias-pull-down;
			drive-strength = <2>;
			output-low;
		};
	};

	cam_sensor_active_ultra: cam_sensor_active_ultra {

		mux {
			pins = "gpio25", "gpio29";
			function = "gpio";
		};

		config {
			pins = "gpio25", "gpio29";
			bias-disable;
			drive-strength = <2>;
		};
	};

	cam_sensor_suspend_ultra: cam_sensor_suspend_ultra {

		mux {
			pins = "gpio25", "gpio29";
			function = "gpio";
		};

		config {
			pins = "gpio25", "gpio29";
			bias-pull-down;
			drive-strength = <2>;
			output-low;
		};
	};

	cam_sensor_active_front: cam_sensor_active_front {

		mux {
			pins = "gpio23", "gpio57";
			function = "gpio";
		};

		config {
			pins = "gpio23", "gpio57";
			bias-disable;
			drive-strength = <2>;
		};
	};

	cam_sensor_suspend_front: cam_sensor_suspend_front {

		mux {
			pins = "gpio23", "gpio57";
			function = "gpio";
		};

		config {
			pins = "gpio23", "gpio57";
			bias-pull-down;
			drive-strength = <2>;
			output-low;
		};
	};

	motor_gpio_default: motor_gpio_default {

		mux {
			pins = "gpio55", "gpio91", "gpio66", "gpio88", "gpio90";
			function = "gpio";
		};

		config {
			pins = "gpio55", "gpio91", "gpio66", "gpio88", "gpio90";
			bias-pull-up;
			drive-strength = <2>;
		};
	};

	motor_gpio_fault: motor_gpio_fault {

		mux {
			pins = "gpio43";
			function = "gpio";
		};

		config {
			pins = "gpio43";
			bias-pull-up;
			drive-strength = <2>;
		};
	};

	akm09970_irq {

		akm_irq_active: akm_irq_active {

			mux {
				pins = "gpio93";
				function = "gpio";
			};

			config {
				pins = "gpio93";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		akm_irq_suspend: akm_irq_suspend {

			mux {
				pins = "gpio93";
				function = "gpio";
			};

			config {
				pins = "gpio93";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};

	akm09970_reset {

		akm_reset_active: akm_reset_active {

			mux {
				pins = "gpio64";
				function = "gpio";
			};

			config {
				pins = "gpio64";
				drive-strength = <2>;
				bias-pull-down;
				output-low;
			};
		};

		akm_reset_suspend: akm_reset_suspend {

			mux {
				pins = "gpio64";
				function = "gpio";
			};

			config {
				pins = "gpio64";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};

	msm_gpio_65: msm_gpio_65 {

		mux {
			pins = "gpio65";
			function = "gpio";
		};

		config {
			pins = "gpio65";
			drive-strength = <2>;
			bias-disable;
			output-low;
		};
	};

	msm_gpio_65_output_high: msm_gpio_65_output_high {

		mux {
			pins = "gpio65";
			function = "gpio";
		};

		config {
			pins = "gpio65";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	msm_gpio_69: msm_gpio_69 {

		mux {
			pins = "gpio69";
			function = "gpio";
		};

		config {
			pins = "gpio69";
			drive-strength = <2>;
			bias-pull-down;
		};
	};
};

