&soc {
	/delete-node/ ssphy@88e8000;

	xiaomi_touch {
		compatible = "xiaomi-touch";
		status = "ok";
		touch,name = "xiaomi-touch";
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie-camera-sensor.dtsi): target only, 4.14 bindings, check */
	led_flash_rear: qcom,camera-flash@0 {
		cell-index = <0>;
		reg = <0x00 0x00>;
		compatible = "qcom,camera-flash";
		flash-source = <&pm6150l_flash0 &pm6150l_flash1>;
		torch-source = <&pm6150l_torch0 &pm6150l_torch1>;
		switch-source = <&pm6150l_switch2 &pm6150l_switch2>;
		status = "ok";
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie-camera-sensor.dtsi): target only, 4.14 bindings, check */
	led_flash_rear_aux: qcom,camera-flash@1 {
		cell-index = <1>;
		reg = <0x01 0x00>;
		compatible = "qcom,camera-flash";
		flash-source = <&pm6150l_flash0 &pm6150l_flash1>;
		torch-source = <&pm6150l_torch0 &pm6150l_torch1>;
		switch-source = <&pm6150l_switch2 &pm6150l_switch2>;
		status = "ok";
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie-camera-sensor.dtsi): target only, 4.14 bindings, check */
	led_flash_rear_aux2: qcom,camera-flash@2 {
		cell-index = <2>;
		reg = <0x02 0x00>;
		compatible = "qcom,camera-flash";
		flash-source = <&pm6150l_flash0 &pm6150l_flash1>;
		torch-source = <&pm6150l_torch0 &pm6150l_torch1>;
		switch-source = <&pm6150l_switch2 &pm6150l_switch2>;
		status = "ok";
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie-camera-sensor.dtsi): target only, 4.14 bindings, check */
	tele_actuator_regulator: gpio-regulator@1 {
		compatible = "regulator-fixed";
		reg = <0x01 0x00>;
		regulator-name = "actuator_regulator";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <100>;
		enable-active-high;
		gpio = <&pm6150l_gpios 11 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_actuator_tele_en>;
		vin-supply = <&pm6150l_bob>;
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie.dtsi): target only, 4.14 bindings, check */
	fingerprint_goodix {
		compatible = "goodix,fingerprint";
		goodix,gpio-reset = <&tlmm 65 0x0>;
		goodix,gpio-irq = <&tlmm 69 0x0>;
		fp-gpio-pwr = <&tlmm 63 0>;
		status = "ok";
	};

	/* FROM-4.14 (dt/414/xiaomi/davinci/davinci-sdmmagpie.dtsi): target only, 4.14 bindings, check */
	ti,drv8846@0 {
		cell-index = <0>;
		reg = <0x00 0x00>;
		compatible = "ti,drv8846";
		pwms = <&pm6150l_pwm 1 1000000>;
		motor,gpio-mode0 = <&tlmm 91 0x00>;
		motor,gpio-mode1 = <&tlmm 66 0x00>;
		motor,gpio-sleep = <&tlmm 88 0x00>;
		motor,gpio-dir = <&tlmm 55 0x00>;
		motor,gpio-pwren = <&tlmm 90 0x00>;
		motor,rampup-pwm-period-ns = <625000>;
		motor,rampup-duration-ms = <50>;
		motor,high-pwm-period-ns = <52083>;
		motor,high-duration-ms = <720>;
		motor,rampdown-pwm-period-ns = <625000>;
		motor,rampdown-duration-ms = <50>;
		motor,step-mode = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwm_out_gpio10_default &motor_gpio_default &motor_gpio_fault>;
		status = "ok";
	};
};

&pm6150_vadc {

	pa_therm1 {
		reg = <ADC5_AMUX_THM2_100K_PU>;
		label = "pa_therm1";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	emmc_ufs_therm {
		reg = <ADC5_AMUX_THM3_100K_PU>;
		label = "emmc_ufs_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	quiet_therm {
		reg = <ADC5_AMUX_THM4_100K_PU>;
		label = "quiet_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm6150_charger {
	/* MERGE io-channels: 4.14 target has <&pm6150_vadc ADC5_USB_IN_V_16>, <&pm6150_vadc ADC5_USB_IN_I>, <&pm6150_vadc ADC5_CHG_TEMP>, <&pm6150_vadc ADC5_DIE_TEMP>, <&pm6150l_vadc ADC5_AMUX_THM1_100K_PU>, <&pm6150_vadc ADC_SBUx>, <&pm6150_vadc ADC5_VPH_PWR> */
	/* MERGE io-channel-names: 4.14 target has "usb_in_voltage",
			   "usb_in_current",
			   "chg_temp",
			   "die_temp",
			   "conn_temp",
			   "sbux_res",
			   "vph_voltage" */
	io-channels = <&pm6150_vadc ADC5_USB_IN_V_16>, <&pm6150_vadc ADC5_USB_IN_I>, <&pm6150_vadc ADC5_CHG_TEMP>, <&pm6150_vadc ADC5_DIE_TEMP>, <&pm6150l_vadc ADC5_AMUX_THM1_100K_PU>, <&pm6150_vadc ADC5_SBUx>, <&pm6150_vadc ADC5_VPH_PWR>, <&pm6150_qg PSY_IIO_RESISTANCE_ID>, <&pm6150_qg PSY_IIO_VOLTAGE_NOW>, <&pm6150_qg PSY_IIO_TEMP>, <&pm6150_qg PSY_IIO_CAPACITY>, <&pm6150_qg PSY_IIO_VOLTAGE_OCV>, <&pm6150_qg PSY_IIO_VOLTAGE_AVG>, <&pm6150_qg PSY_IIO_DEBUG_BATTERY>, <&pm6150_qg PSY_IIO_REAL_CAPACITY>, <&pm6150_qg PSY_IIO_CC_SOC>, <&pm6150_qg PSY_IIO_CURRENT_NOW>, <&pm6150_qg PSY_IIO_VOLTAGE_MAX>, <&pm6150_qg PSY_IIO_CHARGE_FULL>, <&pm6150_qg PSY_IIO_CHARGE_COUNTER>, <&pm6150_qg PSY_IIO_CYCLE_COUNT>, <&pm6150_qg PSY_IIO_CHARGE_FULL_DESIGN>, <&pm6150_qg PSY_IIO_TIME_TO_FULL_NOW>;
	io-channel-names = "usb_in_voltage", "usb_in_current", "chg_temp", "die_temp", "conn_temp", "sbux_res", "vph_voltage", "resistance_id", "voltage_now", "temp", "capacity", "voltage_ocv", "voltage_avg", "debug_battery", "real_capacity", "cc_soc", "current_now", "voltage_max", "charge_full", "charge_counter", "cycle_count", "charge_full_design", "time_to_full_now";
	qcom,battery-data = <&mtp_batterydata>;
	dpdm-supply = <&qusb_phy0>;
	qcom,sec-charger-config = <1>;
	qcom,chg-term-src = <1>;
	qcom,chg-term-current-ma = <(-200)>;
	qcom,auto-recharge-soc = <99>;
	qcom,sw-jeita-enable;
	qcom,thermal-mitigation = <3500000 3400000 3300000 3200000 3100000 3000000 2900000 2800000 2600000 2400000 2200000 2000000 1800000 1500000 1000000 500000>;
	qcom,thermal-mitigation-icl = <2800000 2700000 2600000 2400000 2200000 2100000 2000000 2000000 2000000 1900000 1800000 1600000 1500000 1300000 1000000 750000>;
	qcom,thermal-mitigation-dcp = <1800000 1800000 1800000 1800000 1800000 1800000 1800000 1800000 1800000 1700000 1600000 1400000 1200000 1100000 1100000 1000000>;
	qcom,thermal-mitigation-qc2 = <1500000 1500000 1500000 1500000 1450000 1400000 1350000 1300000 1150000 1100000 1000000 900000 850000 750000 650000 500000>;
	qcom,thermal-fcc-qc3-normal = <3500000 3400000 3300000 3200000 3100000 3000000 2900000 2800000 2700000 2600000 2400000 2200000 2000000 2000000 750000 700000>;
	qcom,thermal-mitigation-pd-base = <3500000 3500000 3500000 3500000 3400000 3300000 3200000 3100000 3000000 2800000 2600000 2400000 2200000 2000000 1000000 700000>;
	qcom,usb-icl-ua = <2800000>;
	qcom,fcc-max-ua = <3500000>;
	qcom,fv-max-uv = <4400000>;
	qcom,dynamic-fv-enable;
	qcom,lpd-disable;
	mi,early-status-report;
	qcom,thermal-fcc-qc3-cp = <3500000 3500000 3500000 3500000 3400000 3300000 3200000 3100000 3000000 2800000 2600000 2400000 2200000 2000000 1000000 700000>;
	qcom,thermal-fcc-pps-cp = <3500000 3500000 3500000 3500000 3400000 3300000 3200000 3100000 3000000 2800000 2600000 2400000 2200000 2000000 1000000 700000>;
};

&pm6150_qg {
	qcom,battery-data = <&mtp_batterydata>;
	qcom,qg-iterm-ma = <350>;
	qcom,s3-entry-ibat-ua = <25000>;
	qcom,s3-exit-ibat-ua = <45000>;
	qcom,hold-soc-while-full;
	qcom,linearize-soc;
	qcom,cl-feedback-on;
	qcom,shutdown-soc-threshold = <3>;
	qcom,shutdown-delay-enable;
};

