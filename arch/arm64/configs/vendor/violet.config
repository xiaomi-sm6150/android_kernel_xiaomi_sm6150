# Panics must reset warm so ABL returns to boot and pstore keeps the log:
# no download mode, no watchdog bite.
# CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE is not set
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set

# DEBUG: kernel log on the panel through the ABL splash buffer (simplefb)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
