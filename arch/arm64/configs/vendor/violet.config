# violet (SM6150) on top of gki_defconfig. Everything needed is built in;
# CONFIG_MODULES stays on because GKI vendor code needs it, but nothing is
# shipped as a module. The SoC list comes from sdmsteppeauto_GKI.config.
CONFIG_LOCALVERSION="-violet"

# Debug aids. earlycon=ramoops logs into the ramoops pmsg zone from the first
# printk (0xa1600000 + 4M console); reboot=warm keeps DDR, and so the log,
# across resets.
CONFIG_CMDLINE="console=tty0 fbcon=font:TER16x32 earlycon=ramoops,0xa1a00000 reboot=warm loglevel=8 ignore_loglevel printk.devkmsg=on panic=5 fw_devlink=permissive clk_ignore_unused pd_ignore_unused regulator_ignore_unused deferred_probe_timeout=30"
CONFIG_CMDLINE_EXTEND=y
CONFIG_SERIAL_EARLYCON_RAMOOPS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Faster bring-up builds
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_GUNYAH is not set

# SoC list
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_SA6155=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_BOOTMARKER_PROXY=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_IDLE_GOV_QCOM_LPM=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DP_AUX_BUS=y
# CONFIG_DWMAC_DWC_QOS_ETH is not set
# CONFIG_DWMAC_GENERIC is not set
# CONFIG_DWMAC_INTEL_PLAT is not set
# CONFIG_DWMAC_IPQ806X is not set
# CONFIG_DWMAC_SUN8I is not set
# CONFIG_DWMAC_SUNXI is not set
# CONFIG_ETM4X_IMPDEF_FEATURE is not set
CONFIG_EXTCON_USB_GPIO=y
# CONFIG_GH_DBL is not set
# CONFIG_GH_GUEST_POPS is not set
# CONFIG_GH_IRQ_LEND is not set
# CONFIG_GH_MEM_NOTIFIER is not set
# CONFIG_GH_TLMM_VM_MEM_ACCESS is not set
# CONFIG_GH_VIRT_WATCHDOG is not set
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_HW_RANDOM_MSM_LEGACY=y
# CONFIG_I2C_ARB_GPIO_CHALLENGE is not set
CONFIG_I2C_CHARDEV=y
# CONFIG_I2C_DEMUX_PINCTRL is not set
CONFIG_I2C_MSM_GENI=y
# CONFIG_I2C_MUX_GPIO is not set
