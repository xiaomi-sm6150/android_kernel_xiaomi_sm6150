source "drivers/media/platform/msm/npu/Kconfig"


config SPECTRA_CAMERA
	bool "Qualcomm Technologies, Inc. Spectra camera and video capture support"
	depends on ARCH_QCOM && VIDEO_DEV && I2C
	select VIDEO_V4L2_SUBDEV_API
	help
	  Say Y here to enable the Spectra camera driver stack (sensor, IFE
	  and postprocessing drivers) forward-ported from the 4.14 sm6150
	  kernel. It keeps the 4.14 UAPI the CamX blobs are built against.

